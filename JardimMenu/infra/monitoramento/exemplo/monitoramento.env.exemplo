# Configuração do monitoramento do Jardim Menu.
#
# ESTE ARQUIVO É UM MODELO. O de verdade mora fora do git, em
# /etc/jardim-menu/monitoramento.env, porque tem a chave anon e o token do bot:
#
#   sudo install -d -m 700 /etc/jardim-menu
#   sudo cp infra/monitoramento/exemplo/monitoramento.env.exemplo \
#           /etc/jardim-menu/monitoramento.env
#   sudo chmod 600 /etc/jardim-menu/monitoramento.env

# ---------------------------------------------------------------- ambientes

AMBIENTES="producao staging"

# Os endereços saem do Caddy da frente de infraestrutura (infra/compose). Não
# há domínio decidido ainda (A1 dos requisitos), e por isso o endereço
# provisório usa sslip.io, que resolve o IP embutido no próprio nome e permite
# certificado Let's Encrypt de verdade. HTTPS aqui não é capricho: o tablet usa
# crypto.randomUUID e service worker, e os dois só existem em contexto seguro.
#
# Troque 203-0-113-10 pelo IP do servidor, com tracinhos no lugar dos pontos.
# Os endereços seguem a convenção do gerar-segredos.mjs: <papel>[-<ambiente>].<ip-com-tracos>.sslip.io,
# com PONTO antes do ip, e é isso que o Caddy atende. Troque pelo domínio quando ele existir.
PRODUCAO_URL_APP=https://app.203-0-113-10.sslip.io
PRODUCAO_URL_API=https://api.203-0-113-10.sslip.io
STAGING_URL_APP=https://app-staging.203-0-113-10.sslip.io
STAGING_URL_API=https://api-staging.203-0-113-10.sslip.io

# Chave anon de cada ambiente. O /auth/v1/health passa pelo Kong, que na
# configuração padrão do Supabase exige `apikey` até no health. Sem ela a
# resposta é 401 e o monitor acusaria uma queda que não existe.
# A anon é pública por natureza (trabalha sob RLS). A service_role NÃO entra
# aqui, nem em lugar nenhum deste repositório.
PRODUCAO_CHAVE_ANON=
STAGING_CHAVE_ANON=

# Contêineres que precisam estar de pé, separados por espaço. Os nomes vêm do
# compose da frente de infraestrutura; confira com:
#     docker ps --format '{{.Names}}'
# Os nomes vêm do `container_name` do compose: <PROJETO>-<serviço>. O realtime é a exceção,
# porque a imagem dele exige um nome com ponto. Confira com `docker ps --format '{{.Names}}'`.
PRODUCAO_CONTAINERS="jardim-producao-db jardim-producao-auth jardim-producao-rest realtime-dev.jardim-producao jardim-producao-storage jardim-producao-meta jardim-producao-kong jardim-producao-app"
STAGING_CONTAINERS="jardim-staging-db jardim-staging-auth jardim-staging-rest realtime-dev.jardim-staging jardim-staging-storage jardim-staging-meta jardim-staging-kong jardim-staging-app"

# ---------------------------------------------------------------- rotas

# Rota de saúde do app. Se a versão publicada ainda não tiver /api/saude, o
# monitor vai acusar 404 — e acusar é o certo: a rota faz parte do que sobe.
# Para não gerar alarme enquanto ela não existe, aponte para "/" temporariamente
# e anote a pendência.
CAMINHO_SAUDE_APP=/api/saude
CAMINHO_SAUDE_API=/auth/v1/health

# Códigos considerados "de pé", separados por espaço.
# O /api/saude do app responde 204, sem corpo e sem tocar no banco. Só 200 na lista fazia o
# monitoramento alertar queda desde o primeiro minuto, com tudo de pé.
CODIGOS_OK="200 204"

# Segundos de paciência por requisição. Menor que o intervalo de um minuto,
# com folga para as duas verificações de cada ambiente.
TIMEOUT_SEGUNDOS=8

# ---------------------------------------------------------------- avisos

ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Quantas verificações seguidas falham antes do aviso. 2 = dois minutos.
# Um único minuto ruim é rede, não é queda.
FALHAS_PARA_ALERTAR=2

# Enquanto continuar fora, lembra de quantos em quantos minutos. 0 desliga o
# lembrete (o aviso de queda e o de volta continuam).
MINUTOS_LEMBRETE=60

# ---------------------------------------------------------------- disco

# Acima deste percentual de uso, avisa. O disco é compartilhado pelos dois
# ambientes e pelos backups locais, e disco cheio derruba o Postgres.
LIMITE_DISCO=85
# Só considera resolvido abaixo de LIMITE_DISCO - FOLGA_DISCO, para não ficar
# avisando "encheu"/"esvaziou" com o disco parado na fronteira.
FOLGA_DISCO=5
# Pontos de montagem vigiados, separados por espaço. Se /var estiver em um
# disco separado, inclua os dois.
PONTOS_DE_MONTAGEM="/"

# Onde o monitor guarda o que já avisou.
DIR_ESTADO=/var/lib/jardim-menu/monitoramento
