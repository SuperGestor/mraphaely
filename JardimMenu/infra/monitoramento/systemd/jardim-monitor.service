[Unit]
# Verificação de saúde do Jardim Menu. Quem dispara é o timer de mesmo nome.
Description=Verificação de saúde do Jardim Menu (app, API, contêineres e disco)
Documentation=file:/opt/jardim-menu/JardimMenu/infra/monitoramento/README.md
After=network-online.target docker.service
Wants=network-online.target
# Quem avisa quando alguma coisa cai é o próprio verificar.sh. Quando é ELE que não
# roda — caminho errado no ExecStart (203/EXEC), .env com uma linha que o `source` tenta
# executar (127), TimeoutStartSec estourado, OOM —, não sobra ninguém para falar: a
# unidade fica failed em silêncio e `systemctl list-timers` continua mostrando o timer
# agendado e saudável, porque ele mostra o agendamento e não o resultado. Este OnFailure
# é o único aviso que sobrevive ao script não rodar.
OnFailure=jardim-monitor-falhou.service

[Service]
Type=oneshot
User=root
# Ajuste o caminho se o repositório não estiver em /opt/jardim-menu.
ExecStart=/opt/jardim-menu/JardimMenu/infra/monitoramento/verificar.sh
Environment=JARDIM_MONITOR_ENV=/etc/jardim-menu/monitoramento.env
# Menor que o intervalo do timer: uma verificação nunca pode atropelar a
# seguinte. Se estourar, o systemd mata, e o flock do script protege o resto.
TimeoutStartSec=50
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jardim-monitor

# Sem [Install] de propósito: quem se habilita é o jardim-monitor.timer.
