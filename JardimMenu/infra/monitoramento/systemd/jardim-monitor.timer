[Unit]
Description=Dispara a verificação de saúde do Jardim Menu a cada minuto

[Timer]
# A cada minuto, no segundo zero. Um minuto é o intervalo do requisito, e o
# script só avisa depois de duas falhas seguidas: o alarme de verdade chega em
# cerca de dois minutos, e um soluço de rede não vira aviso.
OnCalendar=*:0/1
# Começa um pouco depois do boot, para não disparar enquanto o Docker ainda
# está subindo os contêineres e acusar queda que é só partida.
OnBootSec=3min
AccuracySec=5s
# Sem Persistent: verificação atrasada não interessa. O que interessa é agora.
Persistent=false
Unit=jardim-monitor.service

[Install]
WantedBy=timers.target
