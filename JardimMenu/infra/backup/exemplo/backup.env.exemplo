# Configuração do backup do Jardim Menu (NF-011).
#
# ESTE ARQUIVO É UM MODELO. O arquivo de verdade mora FORA do git, em
# /etc/jardim-menu/backup.env, porque tem senha de banco e token de bot:
#
#   sudo install -d -m 700 /etc/jardim-menu
#   sudo cp infra/backup/exemplo/backup.env.exemplo /etc/jardim-menu/backup.env
#   sudo chmod 600 /etc/jardim-menu/backup.env
#   sudo nano /etc/jardim-menu/backup.env
#
# Nenhum valor real entra no repositório. Se você se pegar preenchendo este
# arquivo aqui dentro, pare: é o arquivo errado.

# ---------------------------------------------------------------- ambientes

# Quais ambientes o backup percorre, separados por espaço. Os dois vivem no
# mesmo servidor (decisão do PO em 22/09/2026), com stacks Docker separadas.
AMBIENTES="producao staging"

# Como o script chega ao Postgres:
#   docker = entra no contêiner e usa o cliente da própria imagem 17.6.1.167
#            (não depende de ter psql no host, e não há divergência de versão);
#   host   = usa o psql/pg_dump instalados no servidor, por host e porta.
MODO_BANCO=docker

# ---- produção ----
# O nome do contêiner do banco vem do `container_name` do compose: <PROJETO>-db, com o
# PROJETO do .env do ambiente. Confira com `docker ps --format '{{.Names}}'`.
#
# Antes de 23/09/2026 estes valores estavam errados: sem container_name, o compose criava
# `jardim-staging-db-1`, com o sufixo do número de réplica, e o backup não achava o banco.
PRODUCAO_CONTAINER_DB=jardim-producao-db
# supabase_admin, e NÃO postgres: os schemas auth (contas da equipe) e storage (registro
# das fotos) pertencem a ele. Com postgres, o pg_dump omite os dois em silêncio e o backup
# sai sem ninguém conseguir entrar depois de restaurado.
PRODUCAO_PG_USER=supabase_admin
PRODUCAO_PG_DB=postgres
PRODUCAO_PG_SENHA=troque-pela-senha-do-postgres-de-producao
# Fotos do Storage. Preencha UM dos dois blocos:
#   a) o volume montado no host (mais simples de conferir);
PRODUCAO_DIR_STORAGE=/srv/jardim-menu/producao/storage
#   b) ou o contêiner do storage-api e o caminho de dentro dele.
# PRODUCAO_CONTAINER_STORAGE=jardim-producao-storage
# PRODUCAO_CAMINHO_STORAGE=/var/lib/storage

# ---- staging ----
STAGING_CONTAINER_DB=jardim-staging-db
STAGING_PG_USER=supabase_admin
STAGING_PG_DB=postgres
STAGING_PG_SENHA=troque-pela-senha-do-postgres-de-staging
STAGING_DIR_STORAGE=/srv/jardim-menu/staging/storage
# STAGING_CONTAINER_STORAGE=jardim-staging-storage
# STAGING_CAMINHO_STORAGE=/var/lib/storage

# ---------------------------------------------------------------- onde guardar

# Pasta local dos backups. Uma subpasta por ambiente.
DIR_BACKUP=/var/backups/jardim-menu

# Dias que o backup fica no servidor. O histórico longo é do destino externo.
DIAS_RETENCAO_LOCAL=14

# Dias no destino externo. 0 = o script não apaga nada lá fora, e a limpeza
# fica por conta da regra de ciclo de vida do bucket — que é o lugar mais
# seguro para isso, porque credencial roubada não consegue apagar histórico.
DIAS_RETENCAO_REMOTO=0

# ---------------------------------------------------------------- cópia externa

# Destino do rclone, no formato remoto:caminho. O nome do remoto ("b2", "s3",
# "drive") é o que estiver no rclone.conf. Exemplos:
#   RCLONE_REMOTO="b2:jardim-menu-backup"
#   RCLONE_REMOTO="s3:jardim-menu-backup/servidor1"
#   RCLONE_REMOTO="drive:Backups/JardimMenu"
RCLONE_REMOTO="b2:jardim-menu-backup"
RCLONE_CONFIG=/etc/jardim-menu/rclone.conf
RCLONE_OPCOES="--transfers 4 --retries 3 --low-level-retries 10"

# ---------------------------------------------------------------- avisos

# Telegram (canal escolhido pelo PO em 22/09/2026). As mesmas duas variáveis
# são usadas pelo monitoramento e pelo aviso de erro do app (NF-009) — no app
# quem as lê é outra frente; aqui elas só são repassadas.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# De quantos em quantos dias mandar o aviso de "deu certo". Falha avisa sempre.
DIAS_ENTRE_RESUMOS=7

# ---------------------------------------------------------------- conferência

# Tabelas cuja contagem entra no manifesto do backup e é conferida na
# restauração. Mantenha em sintonia com back/supabase/migrations: tabela nova
# que importe para a operação entra aqui.
# Tabela sem schema subentende public. auth.users e storage.objects entram nomeadas porque
# são o que uma restauração incompleta perde sem a contagem acusar.
TABELAS_CONFERIDAS="stores store_users categories products option_groups options product_option_groups tables devices table_sessions table_tabs orders order_items menu_events auth.users storage.objects"

# Guardar também os papéis do cluster (pg_dumpall --globals-only).
DUMP_GLOBAIS=sim

# Onde o script guarda estado (marca do último resumo semanal).
DIR_ESTADO=/var/lib/jardim-menu/backup

# ==========================================================================
# NO RENDER (decisão de 24/09/2026) — substitui os blocos acima
# ==========================================================================
#
# Tudo o que está acima descreve o servidor próprio com compose, que continua
# valendo na máquina de quem desenvolve e na esteira. No Render o backup roda
# num Cron Job, e TRÊS coisas mudam. Descomente este bloco lá, e só lá.
#
# 1) NÃO HÁ `docker exec`: o banco é Private Service, alcançado por host e porta
#    dentro da rede privada (mesma região e mesmo workspace). Daí MODO_BANCO=host.
#    O nome interno NÃO é só o nome do serviço: o Render o mostra como
#    <nome-do-servico>-<hash>, no menu Connect, aba Internal. Copie de lá.
#    A imagem do Cron Job precisa ter postgresql-client-17 (cliente mais velho que
#    o servidor 17.6 é RECUSADO na conexão) e rclone.
#
# 2) NÃO HÁ DISCO: Cron Job do Render não pode ter disco, e one-off job não
#    enxerga o disco do serviço-base. Logo:
#      - DIR_BACKUP vive em /tmp e morre com o disparo;
#      - a cópia externa deixa de ser a segunda via e passa a ser a ÚNICA;
#      - ARMAZENAMENTO_LOCAL_EFEMERO=sim faz o script RECUSAR --sem-remoto e
#        RECUSAR RCLONE_REMOTO vazio, em vez de terminar com "backup em dia"
#        depois de escrever tudo num disco que some.
#
# 3) AS FOTOS NÃO SAEM POR `tar`: o disco do Storage também não é alcançável.
#    MODO_STORAGE=api baixa foto por foto pela API do Storage, com a lista vinda
#    de storage.objects. O tar que sai daí tem OUTRO formato (leia o cabeçalho de
#    dump_storage no backup.sh) e só volta pelo restaurar.sh, também em modo api.
#    A STORAGE_URL é a do Web Service do Kong — o único serviço público.
#
# AMBIENTES="producao staging"
# ARMAZENAMENTO_LOCAL_EFEMERO=sim
# DIR_BACKUP=/tmp/jardim-backup
# DIR_TRAVA=/tmp
# DIR_ESTADO=/tmp/jardim-estado
#
# PRODUCAO_MODO_BANCO=host
# PRODUCAO_PG_HOST=jardim-db-producao-a1b2      # menu Connect > Internal
# PRODUCAO_PG_PORTA=5432
# PRODUCAO_PG_USER=supabase_admin
# PRODUCAO_PG_DB=postgres
# PRODUCAO_PG_SENHA=                            # variável de ambiente do serviço, não aqui
# PRODUCAO_MODO_STORAGE=api
# PRODUCAO_STORAGE_URL=https://jardim-kong-producao.onrender.com
# PRODUCAO_STORAGE_BUCKET=produtos
# PRODUCAO_SERVICE_KEY=                         # service_role; NUNCA sob NEXT_PUBLIC_
#
# STAGING_MODO_BANCO=host
# STAGING_PG_HOST=jardim-db-staging-c3d4
# STAGING_PG_USER=supabase_admin
# STAGING_PG_SENHA=
# STAGING_MODO_STORAGE=api
# STAGING_STORAGE_URL=https://jardim-kong-staging.onrender.com
# STAGING_SERVICE_KEY=
#
# Segredo (PG_SENHA, SERVICE_KEY, token do bot) no Render entra como variável de
# ambiente do serviço, ou Secret File montado em disco — nunca em build arg, que
# fica no histórico da imagem, e nunca em argumento de linha de comando.
# Passe o caminho do Secret File em JARDIM_BACKUP_ENV, ou deixe as variáveis
# soltas no ambiente do serviço: este arquivo é opcional quando elas já estão lá.
