# Configuração do backup do Jardim Menu (NF-011).
#
# ESTE ARQUIVO É UM MODELO. O arquivo de verdade mora FORA do git, em
# /etc/jardim-menu/backup.env, porque tem senha de banco e token de bot:
#
#   sudo install -d -m 700 /etc/jardim-menu
#   sudo cp infra/backup/exemplo/backup.env.exemplo /etc/jardim-menu/backup.env
#   sudo chmod 600 /etc/jardim-menu/backup.env
#   sudo nano /etc/jardim-menu/backup.env
#
# Nenhum valor real entra no repositório. Se você se pegar preenchendo este
# arquivo aqui dentro, pare: é o arquivo errado.

# ---------------------------------------------------------------- ambientes

# Quais ambientes o backup percorre, separados por espaço. Os dois vivem no
# mesmo servidor (decisão do PO em 22/09/2026), com stacks Docker separadas.
AMBIENTES="producao staging"

# Como o script chega ao Postgres:
#   docker = entra no contêiner e usa o cliente da própria imagem 17.6.1.167
#            (não depende de ter psql no host, e não há divergência de versão);
#   host   = usa o psql/pg_dump instalados no servidor, por host e porta.
MODO_BANCO=docker

# ---- produção ----
# O nome do contêiner do banco é definido pela frente de infraestrutura, no
# compose (infra/compose). Confira com `docker ps --format '{{.Names}}'` e
# ajuste aqui: o backup NÃO adivinha o nome.
PRODUCAO_CONTAINER_DB=jardim-producao-db
PRODUCAO_PG_USER=postgres
PRODUCAO_PG_DB=postgres
PRODUCAO_PG_SENHA=troque-pela-senha-do-postgres-de-producao
# Fotos do Storage. Preencha UM dos dois blocos:
#   a) o volume montado no host (mais simples de conferir);
PRODUCAO_DIR_STORAGE=/srv/jardim-menu/producao/storage
#   b) ou o contêiner do storage-api e o caminho de dentro dele.
# PRODUCAO_CONTAINER_STORAGE=jardim-producao-storage
# PRODUCAO_CAMINHO_STORAGE=/var/lib/storage

# ---- staging ----
STAGING_CONTAINER_DB=jardim-staging-db
STAGING_PG_USER=postgres
STAGING_PG_DB=postgres
STAGING_PG_SENHA=troque-pela-senha-do-postgres-de-staging
STAGING_DIR_STORAGE=/srv/jardim-menu/staging/storage
# STAGING_CONTAINER_STORAGE=jardim-staging-storage
# STAGING_CAMINHO_STORAGE=/var/lib/storage

# ---------------------------------------------------------------- onde guardar

# Pasta local dos backups. Uma subpasta por ambiente.
DIR_BACKUP=/var/backups/jardim-menu

# Dias que o backup fica no servidor. O histórico longo é do destino externo.
DIAS_RETENCAO_LOCAL=14

# Dias no destino externo. 0 = o script não apaga nada lá fora, e a limpeza
# fica por conta da regra de ciclo de vida do bucket — que é o lugar mais
# seguro para isso, porque credencial roubada não consegue apagar histórico.
DIAS_RETENCAO_REMOTO=0

# ---------------------------------------------------------------- cópia externa

# Destino do rclone, no formato remoto:caminho. O nome do remoto ("b2", "s3",
# "drive") é o que estiver no rclone.conf. Exemplos:
#   RCLONE_REMOTO="b2:jardim-menu-backup"
#   RCLONE_REMOTO="s3:jardim-menu-backup/servidor1"
#   RCLONE_REMOTO="drive:Backups/JardimMenu"
RCLONE_REMOTO="b2:jardim-menu-backup"
RCLONE_CONFIG=/etc/jardim-menu/rclone.conf
RCLONE_OPCOES="--transfers 4 --retries 3 --low-level-retries 10"

# ---------------------------------------------------------------- avisos

# Telegram (canal escolhido pelo PO em 22/09/2026). As mesmas duas variáveis
# são usadas pelo monitoramento e pelo aviso de erro do app (NF-009) — no app
# quem as lê é outra frente; aqui elas só são repassadas.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# De quantos em quantos dias mandar o aviso de "deu certo". Falha avisa sempre.
DIAS_ENTRE_RESUMOS=7

# ---------------------------------------------------------------- conferência

# Tabelas cuja contagem entra no manifesto do backup e é conferida na
# restauração. Mantenha em sintonia com back/supabase/migrations: tabela nova
# que importe para a operação entra aqui.
TABELAS_CONFERIDAS="stores store_users categories products option_groups options product_option_groups tables devices table_sessions table_tabs orders order_items menu_events"

# Guardar também os papéis do cluster (pg_dumpall --globals-only).
DUMP_GLOBAIS=sim

# Onde o script guarda estado (marca do último resumo semanal).
DIR_ESTADO=/var/lib/jardim-menu/backup
