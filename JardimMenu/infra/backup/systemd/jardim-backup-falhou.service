[Unit]
# Disparado pelo OnFailure= do jardim-backup.service. É o aviso que sobrevive ao script
# não rodar: quando a rodada falha no meio, quem avisa é o próprio backup.sh, com o fim do
# registro; quando ela não chega a começar (caminho errado no ExecStart, config ilegível,
# TimeoutStartSec estourado, OOM), o backup.sh não rodou uma linha sequer e este serviço é
# o único que abre a boca.
Description=Avisa no Telegram que o backup do Jardim Menu falhou
Documentation=file:/opt/jardim-menu/JardimMenu/infra/backup/README.md
# Sem OnFailure= aqui, de propósito: aviso que avisa sobre aviso vira laço. Se este falhar,
# fica no journal e aparece em `systemctl --failed`.

[Service]
Type=oneshot
User=root
# /usr/local/sbin, e NÃO a pasta do repositório: um dos motivos de o backup falhar é
# justamente o caminho do repositório estar errado (o README desta pasta fala em
# /opt/jardim-menu e o preparar-servidor.sh clona em /opt/jardim/repo). Um aviso que mora
# no mesmo caminho que pode estar errado não avisa nada. Instale com:
#   sudo install -m 750 <repo>/infra/backup/systemd/avisar-falha.sh \
#        /usr/local/sbin/jardim-avisar-falha
ExecStart=/usr/local/sbin/jardim-avisar-falha jardim-backup.service
# O token do Telegram é lido de dentro deste arquivo pelo script, sem `source` e sem
# passar por linha de comando (linha de comando aparece no `ps` de qualquer usuário).
Environment=JARDIM_BACKUP_ENV=/etc/jardim-menu/backup.env
# Um aviso que não sai em um minuto não vai sair: o curl já tem --max-time 20.
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jardim-backup-falhou

# Sem [Install]: este serviço não é habilitado nem sobe no boot. Quem o dispara é o
# OnFailure= do jardim-backup.service.
