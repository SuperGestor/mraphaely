# Jardim Menu, ambiente STAGING. EXEMPLO, sem valor real.
#
# Este arquivo está no git para mostrar QUAIS variáveis existem. O arquivo de verdade
# NÃO está, e não é copiado deste aqui à mão: quem o escreve é
#
#   node infra/scripts/gerar-segredos.mjs --ambiente staging --ip <IPv4-do-servidor>
#
# que grava /opt/jardim/ambientes/staging.env com permissão 600, já com senha, JWT
# secret e as chaves anon e service_role sorteados. Depois disso só faltam as linhas
# marcadas com PREENCHER: SMTP e alerta.
#
# Toda linha com <...> aqui é espaço reservado. Se algum <...> chegar ao servidor, o
# compose para na hora com a mensagem da própria variável (`:?defina ...`), de propósito:
# subir meio configurado é pior do que não subir.

# ---- identidade do ambiente ----
# AMBIENTE separa os apelidos de rede (app-staging, api-staging) e PROJETO separa os
# nomes de contêiner, os volumes e a rede interna no Docker. São eles que garantem que
# staging e produção convivam no mesmo servidor sem se tocar (NF-012).
AMBIENTE=staging
PROJETO=jardim-staging
REDE_BORDA=jardim-borda-staging

# ---- endereços públicos ----
# Sem domínio ainda: sslip.io devolve em DNS o IP escrito no próprio nome. Para o IP
# 203.0.113.10 o nome fica api-staging.203-0-113-10.sslip.io. Troque os quatro números
# pelos do servidor. Quando o domínio de verdade chegar, troque aqui, gere a imagem de
# novo (as NEXT_PUBLIC_ entram no build) e suba o Caddy outra vez.
API_EXTERNAL_URL=https://api-staging.<ip-com-tracos>.sslip.io
SUPABASE_PUBLIC_URL=https://api-staging.<ip-com-tracos>.sslip.io
SITE_URL=https://app-staging.<ip-com-tracos>.sslip.io
ADDITIONAL_REDIRECT_URLS=https://app-staging.<ip-com-tracos>.sslip.io/**
# Origens de navegador que a API aceita (CORS no Kong). Separe por vírgula, sem espaço.
CORS_ORIGENS=https://app-staging.<ip-com-tracos>.sslip.io

# ---- segredos do banco e das chaves ----
# NUNCA escreva valor de verdade nestas linhas neste arquivo: ele está no git.
# O gerar-segredos.mjs sorteia todas.
POSTGRES_PASSWORD=<sorteado pelo gerar-segredos.mjs>
POSTGRES_DB=postgres
# Porta do Postgres DENTRO da rede interna do compose. Ela não é publicada no host: o
# banco nunca aparece na internet, e quem precisa de psql entra por `docker compose exec`
# ou por túnel SSH.
POSTGRES_PORT=5432
JWT_SECRET=<sorteado pelo gerar-segredos.mjs>
# Validade do token de LOGIN da equipe, em segundos. Nada a ver com a validade das
# chaves anon e service_role, que é de anos.
JWT_EXPIRY=3600
# JWT HS256 assinados com o JWT_SECRET acima. A anon é pública por natureza: ela vai
# embutida no bundle do navegador, e quem protege os dados é a RLS, não ela.
ANON_KEY=<JWT anon, assinado pelo gerar-segredos.mjs>
# A service_role passa por cima da RLS. Fica só no servidor e nunca, em hipótese
# nenhuma, sob um nome NEXT_PUBLIC_ (regra 4 do CLAUDE.md).
SERVICE_ROLE_KEY=<JWT service_role, assinado pelo gerar-segredos.mjs>

# ---- segredos dos serviços ----
SECRET_KEY_BASE=<sorteado pelo gerar-segredos.mjs>
# Exatamente 16 caracteres: o Realtime cifra a configuração do tenant com AES-128.
REALTIME_DB_ENC_KEY=<sorteado pelo gerar-segredos.mjs, 16 caracteres>
PG_META_CRYPTO_KEY=<sorteado pelo gerar-segredos.mjs>
STORAGE_TENANT_ID=jardim-staging
REGION=local
# O Storage guarda arquivo em disco (STORAGE_BACKEND=file). Este nome de bucket S3 só
# existe porque a imagem exige a variável; nada é enviado para a Amazon.
GLOBAL_S3_BUCKET=stub
# Teto de upload de foto, em bytes. 50 MB.
STORAGE_FILE_SIZE_LIMIT=52428800

# ---- login da equipe (GoTrue) ----
# Cadastro público fechado: quem entra é convidado pelo dono (JM-060..064). O tablet do
# cliente NÃO é usuário do Auth.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
# Em staging pode ficar true para testar sem caixa de e-mail nenhuma. Em produção, não.
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
# PREENCHER: sem SMTP o convite de usuário não sai (JM-060). Serve qualquer serviço de
# envio; a senha aqui é a do serviço, não a do e-mail pessoal de ninguém.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Jardim Menu

# ---- o app ----
IMAGEM_APP=jardim-menu-app
# A tag carrega o ambiente porque a imagem carrega o ambiente: as NEXT_PUBLIC_ ficam
# gravadas no bundle no build. A imagem de staging aponta para a API de staging para
# sempre; promover a mesma imagem para produção apontaria o app de produção para o banco
# de staging. O publicar.sh constrói uma por ambiente justamente por isso.
TAG_APP=staging
NEXT_PUBLIC_SUPABASE_URL=https://api-staging.<ip-com-tracos>.sslip.io
NEXT_PUBLIC_APP_ORIGIN=https://app-staging.<ip-com-tracos>.sslip.io
NEXT_PUBLIC_DATA_SOURCE=supabase
# NEXT_PUBLIC_SUPABASE_ANON_KEY não aparece: o compose a preenche com ANON_KEY, para não
# existirem duas cópias da mesma chave que possam divergir.

# ---- alerta (NF-009) ----
# PREENCHER. O envio é de outra frente; a pilha só repassa estas variáveis para o app.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# ---- versões de imagem (NF-018: atualização controlada) ----
# Fixas, e só mudam por decisão. Sem isto um `docker compose pull` traria versão nova
# sozinho, no pior momento possível. Toda troca passa por staging antes.
VERSAO_POSTGRES=17.6.1.167
VERSAO_GOTRUE=v2.196.0
VERSAO_POSTGREST=v16.2
VERSAO_REALTIME=v2.130.0
VERSAO_STORAGE=v1.72.1
VERSAO_META=v0.99.0
VERSAO_KONG=2.8.1
