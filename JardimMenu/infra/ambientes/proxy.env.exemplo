# Jardim Menu, PROXY (Caddy). EXEMPLO, sem valor real.
#
# O proxy é um só para o servidor inteiro, porque só um processo escuta as portas 80 e
# 443. Ele não tem segredo nenhum: só os nomes públicos e o e-mail do Let's Encrypt.
# Mesmo assim mora ao lado dos outros, em /opt/jardim/ambientes/proxy.env.
#
#   docker compose -p jardim-proxy --env-file /opt/jardim/ambientes/proxy.env \
#     -f infra/proxy/docker-compose.yml up -d
#
# Os nomes abaixo saem prontos na tela do gerar-segredos.mjs de cada ambiente; copie de lá.

# E-mail para onde o Let's Encrypt avisa que o certificado vai vencer. Use um endereço
# que alguém lê de verdade: é o único aviso antes de o HTTPS cair.
ACME_EMAIL=<e-mail de quem cuida do servidor>

# Nomes públicos de cada ambiente. Deixe em branco o par de um ambiente que ainda não
# existe: o Caddyfile cai num nome .localhost, atendido com certificado interno, e não
# incomoda o Let's Encrypt por um host que ninguém acessa.
HOST_APP_STAGING=app-staging.<ip-com-tracos>.sslip.io
HOST_API_STAGING=api-staging.<ip-com-tracos>.sslip.io
HOST_APP_PRODUCAO=app.<ip-com-tracos>.sslip.io
HOST_API_PRODUCAO=api.<ip-com-tracos>.sslip.io

# HSTS em segundos. Curto enquanto o endereço é provisório: HSTS longo em um nome que
# vai ser abandonado trava o navegador do tablet nele por todo esse tempo. Suba para
# 31536000 (um ano) quando o domínio definitivo estiver no ar e estável.
HSTS_MAX_AGE=86400

# Redes de borda, criadas pelo preparar-servidor.sh fora do compose. Precisam bater com
# o REDE_BORDA do .env de cada ambiente.
REDE_BORDA_STAGING=jardim-borda-staging
REDE_BORDA_PRODUCAO=jardim-borda-producao

# Versão do Caddy. Fixe a exata (por exemplo 2.8.4-alpine) assim que o servidor existir,
# para uma atualização não chegar sozinha (NF-018).
VERSAO_CADDY=2-alpine
PROJETO_PROXY=jardim-proxy
