# Jardim Menu, ambiente PRODUÇÃO. EXEMPLO, sem valor real.
#
# Mesmas variáveis do staging.env.exemplo, com os valores que mudam quando o banco passa
# a ter cliente de verdade em cima. Leia o outro primeiro: os comentários longos estão lá,
# e aqui fica só o que é diferente.
#
# O arquivo de verdade sai de
#
#   node infra/scripts/gerar-segredos.mjs --ambiente producao --ip <IPv4-do-servidor>
#
# e grava /opt/jardim/ambientes/producao.env com permissão 600.
#
# Os segredos de produção são OUTROS, sorteados na hora. Nunca copie os de staging: com
# o mesmo JWT_SECRET, uma chave service_role vazada de staging abre o banco de produção.

# ---- identidade do ambiente ----
AMBIENTE=producao
PROJETO=jardim-producao
REDE_BORDA=jardim-borda-producao

# ---- endereços públicos ----
# Em produção o nome fica curto, sem o sufixo do ambiente: é o endereço que a equipe lê e
# digita no tablet. Enquanto não há domínio, o mesmo sslip.io do staging, com outro rótulo.
API_EXTERNAL_URL=https://api.<ip-com-tracos>.sslip.io
SUPABASE_PUBLIC_URL=https://api.<ip-com-tracos>.sslip.io
SITE_URL=https://app.<ip-com-tracos>.sslip.io
ADDITIONAL_REDIRECT_URLS=https://app.<ip-com-tracos>.sslip.io/**
CORS_ORIGENS=https://app.<ip-com-tracos>.sslip.io

# ---- segredos do banco e das chaves ----
POSTGRES_PASSWORD=<sorteado pelo gerar-segredos.mjs>
POSTGRES_DB=postgres
POSTGRES_PORT=5432
JWT_SECRET=<sorteado pelo gerar-segredos.mjs>
JWT_EXPIRY=3600
ANON_KEY=<JWT anon, assinado pelo gerar-segredos.mjs>
SERVICE_ROLE_KEY=<JWT service_role, assinado pelo gerar-segredos.mjs>

# ---- segredos dos serviços ----
SECRET_KEY_BASE=<sorteado pelo gerar-segredos.mjs>
REALTIME_DB_ENC_KEY=<sorteado pelo gerar-segredos.mjs, 16 caracteres>
PG_META_CRYPTO_KEY=<sorteado pelo gerar-segredos.mjs>
STORAGE_TENANT_ID=jardim-producao
REGION=local
GLOBAL_S3_BUCKET=stub
STORAGE_FILE_SIZE_LIMIT=52428800

# ---- login da equipe (GoTrue) ----
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
# FALSE em produção, sem exceção: com autoconfirm ligado, quem digitar o e-mail de outra
# pessoa entra como ela, sem nunca provar que a caixa é sua.
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
# PREENCHER ANTES DE CRIAR O PRIMEIRO USUÁRIO. Em produção o convite é o único caminho
# de entrada da equipe, e ele chega por e-mail (JM-060).
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Jardim Menu

# ---- o app ----
IMAGEM_APP=jardim-menu-app
TAG_APP=producao
NEXT_PUBLIC_SUPABASE_URL=https://api.<ip-com-tracos>.sslip.io
NEXT_PUBLIC_APP_ORIGIN=https://app.<ip-com-tracos>.sslip.io
NEXT_PUBLIC_DATA_SOURCE=supabase

# ---- alerta (NF-009) ----
# PREENCHER. Em produção isto é o que avisa que um pedido se perdeu; sem preencher, o
# erro acontece e ninguém fica sabendo.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# ---- versões de imagem (NF-018) ----
# As MESMAS que rodaram em staging e passaram. Se uma linha daqui for diferente da de
# staging, a subida não foi ensaiada de verdade.
VERSAO_POSTGRES=17.6.1.167
VERSAO_GOTRUE=v2.196.0
VERSAO_POSTGREST=v16.2
VERSAO_REALTIME=v2.130.0
VERSAO_STORAGE=v1.72.1
VERSAO_META=v0.99.0
VERSAO_KONG=2.8.1
