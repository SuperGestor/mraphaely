# Caddy: única coisa que escuta 80 e 443 no servidor. Ele termina o TLS, pede e renova o
# certificado sozinho (Let's Encrypt) e entrega para o contêiner certo, pela rede de
# borda do ambiente.
#
# Por que HTTPS de verdade já no staging: o tablet usa crypto.randomUUID e service worker
# (NF-004), e os dois só existem em contexto seguro. Em http:// o app parece funcionar e
# quebra justamente no pareamento e no modo offline.
#
# ENDEREÇO PROVISÓRIO, enquanto não há domínio: sslip.io devolve, em DNS, o IP que está
# escrito no próprio nome. Para o IP 203.0.113.10:
#
#   app-staging.203-0-113-10.sslip.io
#   api-staging.203-0-113-10.sslip.io
#   app.203-0-113-10.sslip.io
#   api.203-0-113-10.sslip.io
#
# Todos apontam para 203.0.113.10 sem cadastrar nada em lugar nenhum, e o Let's Encrypt
# emite certificado para eles pelo desafio HTTP-01, que só precisa da porta 80 aberta.
# Quando o domínio de verdade chegar, troque as variáveis, suba o Caddy de novo e o
# certificado novo sai sozinho. Nada no app aponta para o endereço provisório: ele mora
# no .env do ambiente (NEXT_PUBLIC_APP_ORIGIN, API_EXTERNAL_URL), e trocar o endereço
# exige construir a imagem de novo, porque as NEXT_PUBLIC_ entram no bundle no build.
#
# Limite do sslip.io: são 50 certificados por semana por domínio registrável no Let's
# Encrypt, e sslip.io é compartilhado com o mundo inteiro. Se o pedido falhar por limite,
# espere ou use o servidor de teste (veja o README). Por isso também não vale ficar
# apagando o volume caddy-dados: é nele que o certificado emitido é guardado.

{
	# Para onde o Let's Encrypt avisa que o certificado vai expirar.
	email {$ACME_EMAIL}

	# Para ensaiar sem gastar o limite de emissão, ligue o ambiente de teste do Let's
	# Encrypt. O certificado sai inválido para o navegador, então é só para ensaio:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Cabeçalhos que valem para todo host. Não entram aqui: Content-Security-Policy, que
# depende do que cada página carrega e seria chute daqui de fora.
(seguranca) {
	header {
		# HSTS. Enquanto o endereço for provisório, o padrão é curto de propósito: um
		# certificado errado com HSTS longo trava o tablet por um ano. Suba para
		# 31536000 quando o domínio definitivo estiver no ar e estável.
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:86400}"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# O app não usa câmera nem localização: quem lê a plaquinha com QR é o app de
		# câmera do próprio celular (CLAUDE.md), nunca uma tela nossa.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Versão do servidor é informação de graça para quem varre a internet, e tirar
		# só o Server não bastava: cada upstream anuncia a sua por um cabeçalho
		# próprio, e eles passavam intactos por aqui. O Kong 2.8.1 sobe com
		# `headers = server_tokens, latency_tokens` (o compose não mexe nisso), então
		# toda resposta da API saía com Via: kong/2.8.1 e os dois X-Kong-*-Latency; o
		# Next manda X-Powered-By: Next.js por padrão. Ou seja: o host da API entregava
		# o nome e a versão exata do gateway, e o host do app entregava o framework,
		# sem uma única requisição autenticada. Nomes fixos em vez de curinga porque a
		# versão do Kong está fixada no compose e estes são os cabeçalhos que ela emite.
		-Server
		-Via
		-X-Kong-Proxy-Latency
		-X-Kong-Upstream-Latency
		-X-Powered-By
	}
}

# Staging não é para ser achado por busca (NF-012: ambiente separado, não vitrine).
(sem_indexacao) {
	header X-Robots-Tag "noindex, nofollow, noarchive"
}

# ---------------------------------------------------------------------------
# STAGING
#
# Quando a variável não está preenchida, o bloco cai num nome .localhost, que o Caddy
# atende com a autoridade interna dele e sem pedir nada ao Let's Encrypt. É assim que o
# arquivo continua válido com um ambiente só no ar.
# ---------------------------------------------------------------------------
{$HOST_APP_STAGING:app-staging.localhost} {
	import seguranca
	import sem_indexacao
	encode zstd gzip
	reverse_proxy app-staging:3000
}

{$HOST_API_STAGING:api-staging.localhost} {
	import seguranca
	import sem_indexacao
	encode zstd gzip
	# WebSocket do Realtime passa por aqui; o Caddy trata o upgrade sem configuração.
	reverse_proxy api-staging:8000
}

# ---------------------------------------------------------------------------
# PRODUÇÃO
# ---------------------------------------------------------------------------
{$HOST_APP_PRODUCAO:app-producao.localhost} {
	import seguranca
	encode zstd gzip
	reverse_proxy app-producao:3000
}

{$HOST_API_PRODUCAO:api-producao.localhost} {
	import seguranca
	encode zstd gzip
	reverse_proxy api-producao:8000
}
