# Jardim Menu, variáveis de ambiente. Copie para .env.local e preencha.
# Nunca versionar .env.local. Nenhum segredo vai em variável NEXT_PUBLIC_ (regra 4).

# ---- Supabase (públicas: a chave anon trabalha sob RLS) ----
# Supabase local: `npx supabase status` mostra os dois valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "supabase" liga a fonte real do cardápio no tablet. Vazio mantém os dados de exemplo.
NEXT_PUBLIC_DATA_SOURCE=

# Origem pública do ambiente, usada na URL do QR de pareamento. Nunca escrita no código.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# ---- Segredos do servidor ----
# Usada em UM arquivo só (back/services/invite-user.ts), para o convite no Auth.
# O teste de segurança falha se ela aparecer em outro arquivo ou no bundle.
SUPABASE_SERVICE_ROLE_KEY=

# NF-009: alerta de falha do pixel, de 5xx de qualquer rota e de pedido não gravado.
# Canal nomeado do projeto: Telegram (decisão do PO em 21/09/2026). O passo a passo para
# criar o bot, criar o grupo e achar o chat_id está em docs/operacao/alerta-telegram.md.
# As duas variáveis são segredo de servidor: nunca sob NEXT_PUBLIC_ (regra 4).
# Vazias: só o registro no log do servidor.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Canal antigo (14/09/2026), que segue funcionando junto do Telegram: URL de webhook de
# Slack, Google Chat ou Discord. A URL é credencial, e nunca aparece em log.
ALERT_WEBHOOK_URL=
