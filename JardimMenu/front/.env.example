# Jardim Menu, variáveis de ambiente. Copie para .env.local e preencha.
# Nunca versionar .env.local. Nenhum segredo vai em variável NEXT_PUBLIC_ (regra 4).

# ---- Supabase (públicas: a chave anon trabalha sob RLS) ----
# Supabase local: `npx supabase status` mostra os dois valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "supabase" liga a fonte real do cardápio no tablet. Vazio mantém os dados de exemplo.
NEXT_PUBLIC_DATA_SOURCE=

# Origem pública do ambiente, usada na URL do QR de pareamento. Nunca escrita no código.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# ---- Segredos do servidor ----
# Usada em UM arquivo só (back/services/invite-user.ts), para o convite no Auth.
# O teste de segurança falha se ela aparecer em outro arquivo ou no bundle.
SUPABASE_SERVICE_ROLE_KEY=

# NF-009: alerta de falha do pixel e de 5xx. URL de webhook do canal escolhido
# (Slack, Google Chat ou Discord). Vazio: só o registro no log do servidor.
ALERT_WEBHOOK_URL=
