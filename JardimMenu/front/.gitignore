# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Saídas do Playwright: trace e vídeo de execução não são código, e pesam.
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# O modelo, sem valores, é versionado.
!.env.example

# service worker gerado pelo Serwist no build (app/sw.ts é a fonte)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
